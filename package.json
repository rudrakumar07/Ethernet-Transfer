{
  "name": "ethertransfer",
  "productName": "EtherTransfer",
  "version": "0.1.0",
  "description": "Cross-platform LAN/direct-cable file transfer with live network visualization",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b tsconfig.shared.json tsconfig.core.json tsconfig.main.json tsconfig.preload.json tsconfig.renderer.json",
    "lint": "eslint . --ext .ts,.tsx",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@peculiar/x509": "^1.12.3",
    "bonjour-service": "^1.2.1",
    "d3-force": "^3.0.0",
    "electron-log": "^5.2.0",
    "recharts": "^2.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^16.4.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
