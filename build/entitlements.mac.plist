<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required by Electron's hardened runtime for the renderer's JIT (V8). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- EtherTransfer's actual capabilities (spec §4.6): discovery and
       transfer both need outbound and inbound connections on the LAN. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- macOS 15+ Local Network permission prompt (spec §4.6) is driven by
       NSLocalNetworkUsageDescription/NSBonjourServices in Info.plist, not an
       entitlement, but sandboxed builds also need this to reach it at all. -->
  <key>com.apple.security.app-sandbox</key>
  <false/>
</dict>
</plist>
